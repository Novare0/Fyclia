{
  "manifest_version": 3,
  "name": "Ficlya",
  "version": "1.0",
  "description": "Automatiza la navegación de un lector web sin interferir con métricas.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "Ficlya Logo PNG.png"
    }
  },
  "icons": {
    "128": "Ficlya Logo PNG.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}